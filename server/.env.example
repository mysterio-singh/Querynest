# QueryNest Server Environment Configuration

# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/querynest?retryWrites=true&w=majority
MONGODB_URI=

# Ollama Local Service Configuration
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=embeddinggemma

# Vector Search Index Configuration (must match MongoDB Atlas Search index definition)
VECTOR_INDEX_NAME=vector_index
EMBEDDING_DIMENSIONS=768

# Upload & File Limits
MAX_FILE_SIZE_MB=15

# Chunking Strategy Configuration
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=60

# Environment
NODE_ENV=development
